# Copy to .env; never commit real credentials.
OPENAI_API_KEY=""
TWILIO_TOKEN=""
TWILIO_SID=""
# Registered Twilio WhatsApp sender or Sandbox sender.
TWILIO_WHATSAPP_FROM="whatsapp:+15551234567"
# Comma-separated personal/test numbers; an empty list fails startup.
ALLOWED_WHATSAPP_SENDERS="whatsapp:+15557654321"
# Exact public webhook URL, including the path. Required in production.
TWILIO_APP_URL="https://your-tunnel.example/v0/twilio"
ENVIRONMENT="dev"
# Local only. Render production requires an external PostgreSQL URL.
DATABASE_URL="sqlite:///wappler.db"
# Rolling windows; sender limit may be reduced but never exceed 10.
SENDER_HOURLY_LIMIT=10
GLOBAL_HOURLY_LIMIT=40
GLOBAL_DAILY_LIMIT=100
MAX_PENDING_JOBS=20
WORKER_CONCURRENCY=2
MAX_AUDIO_SECONDS=300
PROCESSING_ENABLED=true
WORKER_ENABLED=true
# Used only by the explicitly enabled live messaging test.
TWILIO_TEST_MSG_TO="whatsapp:+15557654321"
